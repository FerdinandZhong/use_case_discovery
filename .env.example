# ── Admin secret (required) ───────────────────────────────────────────────────
# Gates the /admin dashboard and catalog export. Generate with: openssl rand -hex 24
ADMIN_TOKEN="change-me-to-a-long-random-string"

# ── Datastore ─────────────────────────────────────────────────────────────────
# DEFAULT: embedded SQLite — no external service, data stays in the container /
# Workbench project. Set the file path (mount this dir as a volume to persist).
SQLITE_PATH="./data/survey.db"

# OPTIONAL: to use Postgres instead (e.g. a Cloudera-approved managed instance),
# set DATABASE_URL. When present, Postgres is used and SQLITE_PATH is ignored.
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# PGSSL=disable   # set only if connecting to a Postgres without TLS

# ── LLM (Stage 2 workshop cockpit) ────────────────────────────────────────────
# OpenAI-compatible chat endpoint used by the multi-agent workshop pass.
# Works with Cloudera AI Inference (CAII), ray-serve-cai vLLM, OpenAI, etc.
# BASE_URL must include the /v1 suffix. Leave unset to disable AI features
# (the survey + dashboard + manual editing still work).
# These can also be set in-app at /admin/settings (DB overrides these env vars).
# LLM_BASE_URL="https://<caii-endpoint>/v1"
# LLM_API_KEY="..."
# LLM_MODEL="<model-id-as-deployed>"

# ── Optional ──────────────────────────────────────────────────────────────────
# Serve under a subpath (must match the CML Application base path if used).
# NEXT_PUBLIC_BASE_PATH=""
NEXT_TELEMETRY_DISABLED=1
